# Database configuration
DATABASE_URL="postgresql://postgres:password@localhost:5433/emms_dev?schema=public"

# Docker Postgres variables (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=emms_dev

# Authentication (Auth.js / NextAuth v4)
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# Production (Vercel + Railway) — set in the platform dashboards, never committed.
# NEXTAUTH_URL must be the canonical public URL of the deployed app.
# NEXTAUTH_URL="https://emms.vercel.app"
# DATABASE_URL points at the Railway PostgreSQL service.
# REDIS_URL points at the Railway Redis service (rediss:// over TLS).

# Redis Caching
REDIS_URL="redis://localhost:6379"
