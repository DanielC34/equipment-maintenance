# Database configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/emms_dev?schema=public"

# Docker Postgres variables (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=emms_dev

# Authentication (Auth.js / NextAuth v4)
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
# NEXTAUTH_URL is inferred in development; set it explicitly in production.
# NEXTAUTH_URL="http://localhost:3000"

# Redis Caching
REDIS_URL="redis://localhost:6379"
